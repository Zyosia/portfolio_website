---
import type { GetStaticPaths } from 'astro';

import ProjectView from '../../../components/views/ProjectView.astro';
import { getProjects, type LocalizedProject } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects('en');
  return projects.map((project) => ({ params: { id: project.slug }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: LocalizedProject;
}
---

<ProjectView project={Astro.props.project} />
