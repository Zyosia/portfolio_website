---
import { buildCanonicalUrl, buildPageTitle } from '../lib/seo';

interface Props {
  siteName: string;
  description: string;
  title?: string | undefined;
  ogType?: 'website' | 'article' | 'profile' | undefined;
  noindex?: boolean | undefined;
}

const { siteName, description, title, ogType = 'website', noindex = false } = Astro.props;

if (!Astro.site) {
  throw new Error('`site` must be set in astro.config.mjs (SITE_URL env var).');
}

const fullTitle = buildPageTitle(title, siteName);
const canonical = buildCanonicalUrl(Astro.url.pathname, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en" />
<meta name="twitter:card" content="summary" />

<link rel="sitemap" href="/sitemap.xml" />
