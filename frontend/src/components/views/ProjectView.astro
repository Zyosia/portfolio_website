---
import { render } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import type { LocalizedProject } from '../../lib/content';
import { localizePath } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { formatMonthYear } from '../../lib/projects';
import ButtonLink from '../ButtonLink.astro';
import PageHeader from '../PageHeader.astro';
import TagList from '../TagList.astro';

interface Props {
  project: LocalizedProject;
}

const { project } = Astro.props;
const { locale, slug } = project;
const t = ui(locale).projects;
const { title, summary, date, tags, techStack, cover, coverAlt, repositoryUrl, demoUrl } =
  project.data;
const { Content } = await render(project);
---

<BaseLayout locale={locale} title={title} description={summary} ogType="article">
  <article>
    <PageHeader title={title} path={`~/projects/${slug}`} lead={summary}>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-sm text-muted">
        <time datetime={date.toISOString()}>{formatMonthYear(date, locale)}</time>
        <TagList tags={tags} label={t.tags} />
      </div>
      {(repositoryUrl ?? demoUrl) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {demoUrl && <ButtonLink href={demoUrl}>{t.liveDemo}</ButtonLink>}
          {repositoryUrl && (
            <ButtonLink href={repositoryUrl} variant={demoUrl ? 'secondary' : 'primary'}>
              {t.sourceCode}
            </ButtonLink>
          )}
        </div>
      )}
    </PageHeader>

    <Image
      src={cover}
      alt={coverAlt}
      widths={[640, 960, 1280]}
      sizes="(min-width: 1152px) 72rem, 100vw"
      loading="eager"
      data-reveal
      class="aspect-video w-full rounded-(--radius-card) border border-border object-cover"
    />

    <div data-reveal class="mt-12 grid gap-12 lg:grid-cols-[1fr_16rem]">
      <div class="prose-content">
        <Content />
      </div>
      <aside aria-labelledby="stack-title" class="lg:order-last">
        <h2 id="stack-title" class="font-mono text-sm text-accent">
          {t.techStack}
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2 lg:flex-col lg:items-start">
          {techStack.map((tech) => (
            <li class="rounded-md bg-surface-muted px-2.5 py-1 text-sm">{tech}</li>
          ))}
        </ul>
      </aside>
    </div>

    <p class="mt-16">
      <a
        href={localizePath('/projects', locale)}
        class="font-mono text-sm text-muted hover:text-accent"
      >
        <span aria-hidden="true">← </span>
        {t.backToAll}
      </a>
    </p>
  </article>
</BaseLayout>
