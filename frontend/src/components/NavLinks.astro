---
import { localizePath, stripLocale, type Locale } from '../lib/i18n/locales';
import { ui } from '../lib/i18n/ui';
import { NAV_ITEMS } from '../lib/navigation';
import { isActivePath } from '../lib/paths';

interface Props {
  locale: Locale;
  /** `row` for the desktop bar, `column` for the mobile menu. */
  layout: 'row' | 'column';
}

const { locale, layout } = Astro.props;
const currentPath = stripLocale(Astro.url.pathname);
const labels = ui(locale).nav;
---

<ul class:list={['flex', layout === 'row' ? 'items-center gap-1' : 'flex-col gap-1']}>
  {NAV_ITEMS.map((item) => {
    const active = isActivePath(currentPath, item.path);
    return (
      <li>
        <a
          href={localizePath(item.path, locale)}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'block rounded-md px-3 py-2 font-mono text-sm transition-colors',
            active ? 'text-accent' : 'text-muted hover:bg-surface-muted hover:text-fg',
          ]}
        >
          <span aria-hidden="true" class:list={[active ? 'text-accent' : 'text-transparent']}>
            ./
          </span>
          {labels[item.labelKey].toLocaleLowerCase(locale)}
        </a>
      </li>
    );
  })}
</ul>
