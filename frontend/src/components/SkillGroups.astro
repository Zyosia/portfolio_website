---
import type { SkillGroup } from '../lib/schemas';

interface Props {
  groups: readonly SkillGroup[];
  /** Heading level of each category, following the page outline. */
  headingLevel?: 'h3' | 'h4';
}

const { groups, headingLevel: Heading = 'h3' } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {groups.map((group) => (
    <section
      data-reveal
      class="rounded-(--radius-card) border border-border bg-surface p-5 break-inside-avoid"
    >
      <Heading class="font-mono text-sm text-accent">{group.category}</Heading>
      <ul class="mt-3 flex flex-wrap gap-2">
        {group.items.map((item) => (
          <li class="rounded-md bg-surface-muted px-2.5 py-1 text-sm">{item}</li>
        ))}
      </ul>
    </section>
  ))}
</div>
