---
import type { Locale } from '../lib/i18n/locales';
import { ui } from '../lib/i18n/ui';
import type { TagCount } from '../lib/projects';
import { tagSlug } from '../lib/projects';

interface Props {
  locale: Locale;
  tags: readonly TagCount[];
  total: number;
}

const { locale, tags, total } = Astro.props;
const t = ui(locale).projects;
const buttonClass =
  'rounded-full border border-border px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-on-accent';
---

<!--
  Hidden until the script runs: without JavaScript every project is listed, which is a
  complete experience; filter buttons that do nothing would not be.
-->
<div data-project-filter hidden class="mb-8">
  <div role="group" aria-label={t.filterLabel} class="flex flex-wrap gap-2">
    <button type="button" data-tag="" data-label="" aria-pressed="true" class={buttonClass}>
      {t.all} <span aria-hidden="true">({total})</span>
    </button>
    {tags.map(({ tag, count }) => (
      <button
        type="button"
        data-tag={tagSlug(tag)}
        data-label={tag}
        aria-pressed="false"
        class={buttonClass}
      >
        {tag} <span aria-hidden="true">({count})</span>
      </button>
    ))}
  </div>
  <p data-filter-status role="status" class="sr-only"></p>
</div>

<script>
  import '../scripts/project-filter';
</script>
