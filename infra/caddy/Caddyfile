# Caddy configuration of the `web` container.
# DOMAIN comes from the environment (see .env.example). With `localhost`, Caddy serves
# HTTPS with its own local CA; with a public domain, it obtains Let's Encrypt certificates.

{
	# The admin API is not needed at runtime; disabling it removes an attack surface.
	admin off
}

(security_headers) {
	# HSTS only for real domains: on `localhost` it would also force HTTPS onto the
	# Astro dev server (HSTS ignores ports).
	@public_host not host localhost
	header @public_host Strict-Transport-Security "max-age=31536000; includeSubDomains"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Script/style hashes are in a per-page <meta> CSP generated by Astro. Directives that
		# a <meta> tag cannot carry (frame-ancestors) live here; both policies apply.
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		-Server
	}
}

{$DOMAIN:localhost} {
	import security_headers
	encode zstd gzip

	# --- API ---------------------------------------------------------------------------
	# Caddy is the edge: it replaces any client-supplied X-Forwarded-For with the real peer
	# address, so the API can rate-limit on it without being spoofed.
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy api:8000
	}

	# --- Legacy URLs -------------------------------------------------------------------
	# French moved from /fr to the root when it became the default language: permanent
	# redirects keep shared links and search results working.
	redir /fr / 301
	@legacy_fr path_regexp legacy_fr ^/fr(/.*)$
	redir @legacy_fr {re.legacy_fr.1} 301

	# --- Static site -------------------------------------------------------------------
	handle {
		root * /srv

		# Fingerprinted assets (JS, CSS, fonts, images) never change: cache for a year.
		@hashed path /_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# HTML and other files: always revalidate (cheap thanks to ETag / Last-Modified).
		@not_hashed not path /_astro/*
		header @not_hashed Cache-Control "public, max-age=0, must-revalidate"

		# Clean URLs: /about is served from about.html.
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Not-found page in the language of the requested URL.
	handle_errors 404 {
		root * /srv
		@english path /en /en/*
		rewrite @english /en/404.html
		rewrite * /404.html
		file_server
	}
}

# Internal health endpoint for the Docker healthcheck; this port is never published.
http://:8080 {
	respond /healthz "OK" 200
}
