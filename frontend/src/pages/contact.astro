---
import ContactForm from '../components/ContactForm.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile } from '../lib/content';

const profile = await getProfile();
const elsewhere = [
  { label: 'LinkedIn', href: profile.links.linkedin, hint: 'Professional network' },
  { label: 'GitHub', href: profile.links.github, hint: 'Code and open source' },
];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${profile.name} about a role, a project or a question.`}
>
  <PageHeader
    title="Contact"
    path="~/contact"
    lead="A role, a project, a question about my work? Send me a message and I will reply by email."
  />

  <div class="grid gap-12 lg:grid-cols-[1fr_18rem]">
    <ContactForm />

    <aside aria-labelledby="elsewhere-title">
      <h2 id="elsewhere-title" class="font-mono text-sm text-accent">
        Elsewhere
      </h2>
      <ul class="mt-4 space-y-3">
        {elsewhere.map((link) => (
          <li>
            <a
              href={link.href}
              rel="me"
              class="group block rounded-(--radius-card) border border-border bg-surface p-4 transition-colors hover:border-accent"
            >
              <span class="font-semibold group-hover:text-accent">{link.label}</span>
              <span class="block text-sm text-muted">{link.hint}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</BaseLayout>
