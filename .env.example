# Copy to `.env` and fill in real values. `.env` is never committed.
# Every variable used anywhere in the project is documented here.

# --- Site ------------------------------------------------------------------
# Public domain served by Caddy. Use `localhost` locally (Caddy then issues a
# locally-trusted certificate).
DOMAIN=localhost
# Canonical absolute URL of the site, used at frontend build time for
# canonical links, Open Graph URLs and the sitemap. No trailing slash.
SITE_URL=https://localhost

# --- API -------------------------------------------------------------------
# `production` disables the OpenAPI docs and logs JSON. `development` enables the docs at
# /api/docs and human-readable logs (compose.dev.yaml sets it for `make dev`).
APP_ENV=production
LOG_LEVEL=INFO

# --- SMTP (transactional provider: Brevo, Resend, Mailgun...) ---------------
# In dev, compose.dev.yaml overrides these to point at Mailpit.
SMTP_HOST=smtp.example-provider.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Upgrade a plain connection with STARTTLS (port 587). Mutually exclusive with SMTP_USE_TLS.
SMTP_STARTTLS=true
# Implicit TLS from the first byte (port 465).
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10

# --- Contact form ----------------------------------------------------------
# `From` address of contact emails (must be a sender verified by the provider).
CONTACT_FROM_EMAIL=no-reply@example.com
# Inbox that receives contact messages.
CONTACT_TO_EMAIL=you@example.com
# Per-client-IP rate limit: at most N accepted requests per window.
CONTACT_RATE_LIMIT_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Deployment (compose.yaml) ---------------------------------------------
# Image names without tag. Production: ghcr.io/<owner>/portfolio-web and ...-api, with the
# GitHub owner in lowercase (GHCR requires lowercase names).
WEB_IMAGE=portfolio-web
API_IMAGE=portfolio-api
# Image tag to run: a git SHA in production (enables rollback), `local` locally.
IMAGE_TAG=local
