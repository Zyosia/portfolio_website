---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/content';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { collectTags, tagSlug } from '../../lib/projects';
import PageHeader from '../PageHeader.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectFilter from '../ProjectFilter.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui(locale).projects;
const projects = await getProjects(locale);
const tags = collectTags(projects);
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
  <PageHeader title={t.title} path="~/projects" lead={t.lead} />

  {projects.length === 0 ? (
    <p class="text-muted">{t.empty}</p>
  ) : (
    <>
      <ProjectFilter locale={locale} tags={tags} total={projects.length} />
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project, index) => (
          <li data-project-tags={project.data.tags.map(tagSlug).join(' ')}>
            <ProjectCard project={project} headingLevel="h2" eager={index < 3} />
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
