---
import { CONTACT_ENDPOINT } from '../lib/contact-api';
import { CONTACT_LIMITS } from '../lib/contact-validation';
import type { Locale } from '../lib/i18n/locales';
import { ui } from '../lib/i18n/ui';

interface Props {
  locale: Locale;
}

const t = ui(Astro.props.locale).contact;

const labelClass = 'block text-sm font-semibold';
const fieldClass =
  'mt-2 block w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-fg placeholder:text-muted/70 focus:border-accent focus:outline-2 focus:outline-offset-0 focus:outline-accent aria-invalid:border-danger';
const errorClass = 'mt-1.5 text-sm text-danger';
---

<form
  data-contact-form
  action={CONTACT_ENDPOINT}
  method="post"
  class="relative space-y-6 rounded-(--radius-card) border border-border bg-surface p-6 sm:p-8"
  aria-describedby="contact-required-hint"
>
  <p id="contact-required-hint" class="text-sm text-muted">
    {t.requiredHint}
  </p>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="contact-name" class={labelClass}>
        {t.name} <span aria-hidden="true">*</span>
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength={CONTACT_LIMITS.nameMax}
        aria-describedby="contact-name-error"
        class={fieldClass}
      />
      <p id="contact-name-error" data-error-for="name" class={errorClass} hidden></p>
    </div>

    <div>
      <label for="contact-email" class={labelClass}>
        {t.email} <span aria-hidden="true">*</span>
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        maxlength={CONTACT_LIMITS.emailMax}
        aria-describedby="contact-email-error"
        class={fieldClass}
      />
      <p id="contact-email-error" data-error-for="email" class={errorClass} hidden></p>
    </div>
  </div>

  <div>
    <label for="contact-subject" class={labelClass}>
      {t.subject} <span class="font-normal text-muted">{t.optional}</span>
    </label>
    <input
      id="contact-subject"
      name="subject"
      type="text"
      maxlength={CONTACT_LIMITS.subjectMax}
      aria-describedby="contact-subject-error"
      class={fieldClass}
    />
    <p id="contact-subject-error" data-error-for="subject" class={errorClass} hidden></p>
  </div>

  <div>
    <label for="contact-message" class={labelClass}>
      {t.message} <span aria-hidden="true">*</span>
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="7"
      required
      minlength={CONTACT_LIMITS.messageMin}
      maxlength={CONTACT_LIMITS.messageMax}
      aria-describedby="contact-message-error"
      class:list={[fieldClass, 'resize-y']}
    ></textarea>
    <p id="contact-message-error" data-error-for="message" class={errorClass} hidden></p>
  </div>

  <!--
    Honeypot: positioned off-screen and removed from the accessibility tree and tab order,
    so only bots fill it in. The server silently drops messages where it is not empty.
  -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label for="contact-website">{t.website}</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-full bg-accent px-6 py-2.5 text-sm font-semibold text-on-accent transition-colors hover:bg-accent-strong disabled:cursor-wait disabled:opacity-70"
    >
      {t.send}
    </button>
    <p
      data-form-status
      role="status"
      aria-live="polite"
      class="text-sm data-[state=error]:text-danger data-[state=success]:text-success"
    ></p>
  </div>

  <noscript>
    <p class="text-sm text-muted">{t.noScript}</p>
  </noscript>
</form>

<script>
  import '../scripts/contact-form';
</script>
