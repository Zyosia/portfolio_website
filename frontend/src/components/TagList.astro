---
interface Props {
  tags: readonly string[];
  label: string;
}

const { tags, label } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label={label}>
  {tags.map((tag) => (
    <li class="rounded-full border border-border px-2.5 py-0.5 font-mono text-xs text-muted">
      {tag}
    </li>
  ))}
</ul>
