---
import { NAV_ITEMS } from '../lib/navigation';
import { isActivePath } from '../lib/paths';

interface Props {
  /** `row` for the desktop bar, `column` for the mobile menu. */
  layout: 'row' | 'column';
}

const { layout } = Astro.props;
const currentPath = Astro.url.pathname;
---

<ul class:list={['flex', layout === 'row' ? 'items-center gap-1' : 'flex-col gap-1']}>
  {NAV_ITEMS.map((item) => {
    const active = isActivePath(currentPath, item.href);
    return (
      <li>
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'block rounded-md px-3 py-2 font-mono text-sm transition-colors',
            active ? 'text-accent' : 'text-muted hover:bg-surface-muted hover:text-fg',
          ]}
        >
          <span aria-hidden="true" class:list={[active ? 'text-accent' : 'text-transparent']}>
            ./
          </span>
          {item.label.toLowerCase()}
        </a>
      </li>
    );
  })}
</ul>
