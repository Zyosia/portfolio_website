---
interface Props {
  /** Two-digit section index, e.g. `01`. */
  index: string;
  title: string;
  id?: string;
}

const { index, title, id } = Astro.props;
---

<div data-reveal class="mb-8 flex items-end justify-between gap-4 border-b border-border pb-3">
  <h2 id={id} class="flex items-baseline gap-3 text-2xl font-semibold tracking-tight">
    <span class="font-mono text-sm font-normal text-accent">{index}</span>
    {title}
  </h2>
  <slot />
</div>
